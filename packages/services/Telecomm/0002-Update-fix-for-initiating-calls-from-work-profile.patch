From 173b44c280dd776b0ce2b0d3321ba3fe6f4100a9 Mon Sep 17 00:00:00 2001
From: Pranav Madapurmath <pmadapurmath@google.com>
Date: Tue, 2 Jun 2026 14:23:36 -0700
Subject: [PATCH 2/4] Update fix for initiating calls from work profile

It was found that getting the getQualifiedDefaultHolderPackageName from
Role used the the system user, which would falsely indicate that the
default system dialer role was active for the work profile space in
Android 14. Explicit cross checking with package manager is required to
ensure that the corresponding role is enabled within the wokr profile
context.

Bug: 479515555
Flag: EXEMPT BUGFIX
Test: verified via PoC
Change-Id: I5f004f94dc282cb96ba4f74dc38ddd04b7dbdd6e
Merged-In: I5f004f94dc282cb96ba4f74dc38ddd04b7dbdd6e
---
 .../server/telecom/CallIntentProcessor.java     | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/com/android/server/telecom/CallIntentProcessor.java b/src/com/android/server/telecom/CallIntentProcessor.java
index b971b1f..19391b7 100644
--- a/src/com/android/server/telecom/CallIntentProcessor.java
+++ b/src/com/android/server/telecom/CallIntentProcessor.java
@@ -13,6 +13,7 @@ import android.content.Context;
 import android.content.Intent;
 import android.content.pm.PackageManager;
 import android.content.pm.ResolveInfo;
+import android.content.pm.ApplicationInfo;
 import android.net.Uri;
 import android.os.Bundle;
 import android.os.Looper;
@@ -29,6 +30,8 @@ import android.telephony.DisconnectCause;
 import android.telephony.PhoneNumberUtils;
 import android.telephony.TelephonyManager;
 import android.widget.Toast;
+
+import java.util.List;
 import java.util.concurrent.CompletableFuture;
 /**
  * Single point of entry for all outgoing and incoming calls.
@@ -273,7 +276,19 @@ public class CallIntentProcessor {
     private static boolean doesUserHaveDialerRoleHolder(Context context, UserHandle user) {
         Context userContext = context.createContextAsUser(user, 0);
         RoleManager roleManager = userContext.getSystemService(RoleManager.class);
-        return roleManager.getRoleHolders(RoleManager.ROLE_DIALER).size() > 0;
+        List<String> roleHolders = roleManager.getRoleHolders(RoleManager.ROLE_DIALER);
+        if (roleHolders == null || roleHolders.isEmpty()) {
+            return false;
+        }
+
+        String dialerPackage = roleHolders.get(0);
+        try {
+            ApplicationInfo info = userContext.getPackageManager()
+                    .getApplicationInfo(dialerPackage, 0);
+            return info.enabled;
+        } catch (PackageManager.NameNotFoundException e) {
+            return false;
+        }
     }
 
     /**
