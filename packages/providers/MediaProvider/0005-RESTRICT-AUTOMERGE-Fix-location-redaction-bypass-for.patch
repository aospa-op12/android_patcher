From b37f3ed7a543f2ace3ae3223e4452b368697c30e Mon Sep 17 00:00:00 2001
From: Mohit kumar <imohit@google.com>
Date: Sun, 17 May 2026 11:35:22 +0000
Subject: [PATCH 5/5] RESTRICT AUTOMERGE Fix location redaction bypass for
 oversized XMP boxes.

When an XMP box exceeded the memory limit (1 MiB), IsoInterface would
abort parsing, skipping all subsequent boxes. Additionally,
XmpDataParser would return no redaction ranges for oversized XMP
data because it was treated as an empty document.

This change:
1. Updates IsoInterface to continue parsing even if XMP data is skipped.
2. Updates XmpDataParser to redact the entire XMP range if the data
   buffer is missing due to size limits.
3. Ensures XMP offsets are preserved in XmpDataParser.

Bug: 470265726
Test: atest MediaProviderTests:com.android.providers.media.util.XmpDataParserTest#testContainer_IsoRedactionRanges_OversizedXmp
Flag: EXEMPT BUGFIX
Change-Id: I70fabd8ded71b60cc7ed7c197770a725ee4d8630
---
 .../providers/media/util/IsoInterface.java    |  12 +++++-----
 .../providers/media/util/XmpDataParser.java   |  14 ++++++++++--
 tests/res/raw/gps_test_xmp_big.mp4            | Bin 0 -> 4301936 bytes
 .../media/util/XmpDataParserTest.java         |  21 ++++++++++++++++++
 4 files changed, 39 insertions(+), 8 deletions(-)
 create mode 100644 tests/res/raw/gps_test_xmp_big.mp4

diff --git a/src/com/android/providers/media/util/IsoInterface.java b/src/com/android/providers/media/util/IsoInterface.java
index 235a186..148c2da 100644
--- a/src/com/android/providers/media/util/IsoInterface.java
+++ b/src/com/android/providers/media/util/IsoInterface.java
@@ -189,15 +189,15 @@ public class IsoInterface {
 
             if (Objects.equals(box.uuid, XMP_UUID)) {
                 box.data = allocateBuffer(type, (int) (len - box.headerSize));
-                if (box.data == null) return false;
-
-                Os.read(fd, box.data, 0, box.data.length);
+                if (box.data != null) {
+                    Os.read(fd, box.data, 0, box.data.length);
+                }
             }
         } else if (type == BOX_XMP) {
             box.data = allocateBuffer(type, (int) (len - box.headerSize));
-            if (box.data == null) return false;
-
-            Os.read(fd, box.data, 0, box.data.length);
+            if (box.data != null) {
+                Os.read(fd, box.data, 0, box.data.length);
+            }
         } else if (type == BOX_META && len != headerSize) {
             // The format of this differs in ISO and QT encoding:
             // (iso) [1 byte version + 3 bytes flags][4 byte size of next atom]
diff --git a/src/com/android/providers/media/util/XmpDataParser.java b/src/com/android/providers/media/util/XmpDataParser.java
index 3e48d1d..70ad8be 100644
--- a/src/com/android/providers/media/util/XmpDataParser.java
+++ b/src/com/android/providers/media/util/XmpDataParser.java
@@ -169,6 +169,13 @@ public final class XmpDataParser implements Closeable {
     //    /** The [start, end] offsets in the original file where to-be redacted info is
     //    stored */
     private static LongArray getRedactionRanges(XmpData xmpData) throws IOException {
+        // when the XMP box is too large to load then mRawXmp.length will be 0 but offsets
+        // will be non zero
+        if (xmpData.mRawXmp.length == 0 && xmpData.mXmpOffsets.length > 0) {
+            // If we know the XMP is oversized, redact the entire XMP range.
+            return LongArray.fromArray(xmpData.mXmpOffsets, xmpData.mXmpOffsets.length);
+        }
+
         try (XmpDataParser parser = new XmpDataParser(xmpData.mRawXmp, xmpData.mXmpOffsets)) {
             return parser.getRedactedRanges();
         } catch (XmlPullParserException e) {
@@ -242,13 +249,16 @@ public final class XmpDataParser implements Closeable {
             byte[] buf = iso.getBoxBytesForXmpUuid();
             long[] xmpOffsets = iso.getBoxRangesForXmpUuid();
 
-            if (buf == null) {
+            // getBoxBytesForXmpUuid will return null if the box is not found or if the size
+            // exceeds 1MB. We check xmpOffsets.length to distinguish between these cases.
+            // If xmpOffsets is non-empty, it means the box was too large to load,
+            // and we should not fall back to BOX_XMP.
+            if (buf == null && xmpOffsets.length == 0) {
                 buf = iso.getBoxBytes(IsoInterface.BOX_XMP);
                 xmpOffsets = iso.getBoxRanges(IsoInterface.BOX_XMP);
             }
             if (buf == null) {
                 buf = new byte[0];
-                xmpOffsets = new long[0];
             }
             return new XmpData(buf, xmpOffsets);
         }
