+                        if (cursor != null && cursor.moveToFirst()) {
+                            fileInMediaStore = true;
+                            fetchedOwnerPackageName = cursor.getString(
+                                    cursor.getColumnIndexOrThrow(
+                                            MediaStore.Files.FileColumns.OWNER_PACKAGE_NAME));
