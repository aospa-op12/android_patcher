From 744f08c6f460d7fa50a420f6b0cfff709879ebd8 Mon Sep 17 00:00:00 2001
From: Haofan Wang <haofanw@google.com>
Date: Mon, 1 Jun 2026 15:53:47 -0700
Subject: [PATCH] AIDL CAS HAL: Fix incorrect mmap failure check

mmap() returns MAP_FAILED on failure, not NULL. Checking against
NULL allowed execution to proceed with an invalid pointer (MAP_FAILED),
leading to an arbitrary-address memory access.
This change corrects the failure check to use MAP_FAILED and adds
munmap() cleanup using ScopeGuard to prevent memory leaks.

Bug: 505452999
Test: atest VtsHalCasAidlTargetTest
Flag: EXEMPT BUGFIX
Change-Id: I4805ee90ae1705070b0c43fb9152f666d90963d7
---
 cas/aidl/default/DescramblerImpl.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/cas/aidl/default/DescramblerImpl.cpp b/cas/aidl/default/DescramblerImpl.cpp
index f9c2a65e9f..f1d3e5ee0e 100644
--- a/cas/aidl/default/DescramblerImpl.cpp
+++ b/cas/aidl/default/DescramblerImpl.cpp
@@ -17,6 +17,7 @@
 #define LOG_TAG "android.hardware.cas-DescramblerImpl"
 
 #include <aidlcommonsupport/NativeHandle.h>
+#include <android-base/scopeguard.h>
 #include <inttypes.h>
 #include <media/cas/DescramblerAPI.h>
 #include <media/hardware/CryptoAPI.h>
@@ -101,10 +102,14 @@ ScopedAStatus DescramblerImpl::descramble(ScramblingControl scramblingControl,
 
     // Validate if the offset and size in the SharedBuffer is consistent with the
     // mapped heapbase, since the offset and size is controlled by client.
-    if (srcPtr == NULL) {
+    if (srcPtr == MAP_FAILED) {
         ALOGE("Failed to map src buffer.");
         return toStatus(BAD_VALUE);
     }
+
+    auto sg = ::android::base::make_scope_guard(
+            [srcPtr, size = srcBuffer.heapBase.size]() { munmap(srcPtr, size); });
+
     if (!validateRangeForSize(srcBuffer.offset, srcBuffer.size, srcBuffer.heapBase.size)) {
         ALOGE("Invalid src buffer range: offset %" PRIu64 ", size %" PRIu64
               ", srcMem"
-- 
